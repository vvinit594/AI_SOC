# Compose variable substitution for the repository-root docker-compose.yml.
# Copy to `.env` in this directory. Never commit real `.env` files.
# These defaults are for local development only.

POSTGRES_USER=aisoc
POSTGRES_PASSWORD=aisoc
POSTGRES_DB=aisoc
POSTGRES_PORT=5432

# Host-published backend/frontend URLs used by the browser (not Docker DNS names).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=AI-SOC
CORS_ALLOWED_ORIGINS=http://localhost:3000

# development: empty ANALYST_API_TOKEN allows direct FastAPI decisions as "unverified".
# The Next.js production container still disables /api/analyst (no login session).
APP_ENV=development
ANALYST_API_TOKEN=

LLM_PROVIDER=none
# LLM_API_KEY=
THREAT_INTEL_PROVIDER=none
# THREAT_INTEL_API_KEY=
