# Backend environment variables. Copy to .env and fill in local values.
# Never commit .env. See docs/environment.md.

# --- Phase 3 (required to run the API) ---
APP_ENV=development
APP_NAME=AI-SOC API
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Phase 4 (database) ---
DATABASE_URL=postgresql+psycopg://aisoc:aisoc@localhost:5432/aisoc
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# --- Phase 5 (ingestion / detection) ---
MAX_UPLOAD_SIZE_MB=10
MAX_EVENTS_PER_UPLOAD=50000
RULE_AUTH_FAILURE_THRESHOLD=5
RULE_AUTH_FAILURE_WINDOW_MINUTES=5
RULE_OUTBOUND_CONNECTION_THRESHOLD=10
RULE_OUTBOUND_WINDOW_MINUTES=5
RULE_SEEDED_SUSPICIOUS_IPS=198.51.100.88

# --- Phase 6 (LLM / threat intel) ---
# LLM_PROVIDER=openai
# LLM_API_KEY=
# LLM_MODEL=
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_RETRIES=2
# THREAT_INTEL_PROVIDER=abuseipdb
# THREAT_INTEL_API_KEY=
# THREAT_INTEL_TIMEOUT_SECONDS=10
# THREAT_INTEL_CACHE_TTL_SECONDS=86400

# --- Phase 8–9 (security) ---
# ANALYST_API_TOKEN=
# RATE_LIMIT_INVESTIGATE_PER_MINUTE=5
# RATE_LIMIT_UPLOAD_PER_MINUTE=10
