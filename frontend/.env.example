# Frontend environment variables.
# Copy to .env.local for local development. Never commit real .env.local files.
# See docs/environment.md for the full catalogue.
#
# NEXT_PUBLIC_* values are bundled into the browser. Never put ANALYST_API_TOKEN
# or any other secret in a NEXT_PUBLIC_ variable.

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=AI-SOC

# Server-only (Next.js Route Handler /api/analyst). Not bundled into the browser.
# Required when the backend ANALYST_API_TOKEN is set; leave empty in local
# development if the backend token is also empty (actor "unverified").
# Production disables this proxy because there is no login session.
# ANALYST_API_TOKEN=
# Optional FastAPI origin used only by the server proxy. Defaults to NEXT_PUBLIC_API_BASE_URL.
API_UPSTREAM_URL=http://localhost:8000
