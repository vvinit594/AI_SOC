# Frontend environment variables (non-secret only).
# Copy to .env.local for local development. Never commit real .env.local files.
# See docs/environment.md for the full catalogue.
#
# Do not add ANALYST_API_TOKEN or any NEXT_PUBLIC_ token variable.
# Approve/reject, audit reads, and report download work in development when the
# backend ANALYST_API_TOKEN is empty (actor "unverified").

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=AI-SOC
